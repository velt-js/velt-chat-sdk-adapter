{
  "name": "@veltdev/chat-sdk-adapter",
  "version": "0.2.2",
  "description": "Chat SDK adapter for Velt: build bots that read and reply in anchored comment threads across docs, editors, canvases, PDFs, and video.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/velt-js/velt-chat-sdk-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velt-js/velt-chat-sdk-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/velt-js/velt-chat-sdk-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "velt",
    "chat-sdk",
    "chat-adapter",
    "comments",
    "bot",
    "collaboration"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "chat": "^4.0.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.30.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-mdast": "^10.1.2",
    "mdast-util-to-hast": "^13.2.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.0",
    "chat": "^4.30.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
