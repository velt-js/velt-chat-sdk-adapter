# Velt API key (Velt Console → API Keys)
VELT_API_KEY="your-velt-api-key"

# A Velt auth token for the bot user. Optional: if omitted, the adapter
# generates one from the API key for the bot user, scoped to VELT_ORGANIZATION_ID.
VELT_AUTH_TOKEN=""

# Webhook signing secret.
#   - Advanced (v2) webhooks: the Svix-style secret, e.g. "whsec_..."
#   - Basic (v1) webhooks: the auth token you set in the Console
VELT_WEBHOOK_SECRET="whsec_..."

# Default organization id, used to scope generated bot tokens and as a fallback
# when a webhook payload omits the organization id.
VELT_ORGANIZATION_ID="your-organization-id"
